# Copy this file to runtime/.env (python env/setup_env.py does it for you) and
# fill in your own values. runtime/ is gitignored. NEVER commit the real file.
#
# One file for the whole repo: adsl_adapter (codeindoor_env.py), FineScene
# (finescene_env.py), the aDSL model profiles (credential: {env: ...}) and
# bridge/gateway.py all read it. A variable that is already set in the shell
# wins over this file.

# ======================= secrets =======================
# DeepSeek: LLM planning, scene gate, FineScene vision reviewer.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Only for the aDSL profiles default.yaml / gpt6astra.yaml.
GPT6ASTRA_API_KEY=

# Image model for per-object reference images (furniture_forge / reference_images).
# Any OpenAI-compatible /images/generations endpoint.
IMAGE_API_KEY=
IMAGE_API_BASE=https://us.novaiapi.com/v1
IMAGE_MODEL=gpt-image-2.6

# Optional second image endpoint, tried only when the first one fails
# (relay providers drop their upstream channel without notice).
IMAGE_FALLBACK_API_KEY=
IMAGE_FALLBACK_API_BASE=https://api.chimerahub.org/v1
IMAGE_FALLBACK_MODEL=gpt-image-2.6

# ======================= models =======================
# Vision calls must go to a model that actually sees images. deepseek-v4-pro
# silently drops them (measured 2026-11-13); deepseek-flash reads them.
VIDEO_VISION_MODEL=deepseek-flash
# Local DeepSeek compatibility gateway (python bridge/gateway.py --port 8765)
# CODEINDOOR_GATEWAY=http://127.0.0.1:8765/v1/chat/completions

# ======================= paths =======================
# Everything below is optional. Unset means "use the default in brackets".
#
# Blender 5.x executable [BLENDER_EXE, else `blender` on PATH, else the standard install folder]
# BLENDER_EXE=C:/Program Files/Blender Foundation/Blender 5.2/blender.exe
# BLENDER_EXE=/opt/blender-5.2.4-linux-x64/blender
#
# Toolkits that ship inside this repo [<repo>/aDSL, <repo>/FineScene]
# ADSL_ROOT=
# FINESCENE_ROOT=
# FineScene vision-review profile [<FineScene>/configs/deepseek-flash.yaml]
# FINESCENE_VISION_PROFILE=
#
# Downloaded asset packs, not in git [<repo>/assets]
# ASSETS_ROOT=D:/data/assets
#   STUDY_ASSETS_DIR     [<ASSETS_ROOT>/external/realistic_study_20261019]
#   POLYHAVEN_ASSETS_DIR [<ASSETS_ROOT>/external/polyhaven]
#
# Previously refined aDSL armchair used by FineScene demos [<aDSL>/outputs/medieval_armchair_20261017]
# OAKWARDEN_ASSET_DIR=
#
# Optional TRELLIS / TRELLIS.2 checkouts + their own GPU venv [<repo>/research]
# RESEARCH_ROOT=
# TRELLIS_PYTHON=        [<RESEARCH_ROOT>/trellis_windows_venv/Scripts/python.exe]
#
# aDSL agents: run generated code in an external Blender instead of in-process bpy
# ADSL_BLENDER_EXECUTABLE=
#
# Repo root / env file overrides (rarely needed)
# CODEINDOOR_ROOT=
# CODEINDOOR_ENV_FILE=
#
# ======================= video pipeline (GPU side) =======================
# Python with torch / SAM3 / Any4D / PIL / OpenCV (the "vggrpo" env); also runs
# hand_objects/<id>/textures.py [hand_objects/build.py falls back to the current python]
# TEX_PY=
# SAM3.1 checkpoint, required by geometry/sam3_*.py, closeup_frames.py, locate_front_parts.py
# SAM3_CHECKPOINT=/path/to/sam3/checkpoints/sam3.1/sam3.1_multiplex.pt
# Any4D checkout, cwd for geometry/any4d_reconstruct.py
# ANY4D_ROOT=
# The source footage hand_objects/texlib.py cuts decals from
# SOURCE_VIDEO=/path/to/pantry.mp4
# Fonts for drawn decals [Linux system fonts]
# FONT_CJK=C:/Windows/Fonts/msyh.ttc
# FONT_SANS=C:/Windows/Fonts/arial.ttf
# FONT_SANS_BOLD=C:/Windows/Fonts/arialbd.ttf
