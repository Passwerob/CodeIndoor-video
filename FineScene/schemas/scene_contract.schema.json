{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finescene.local/schema/scene_contract.schema.json",
  "title": "FineScene Scene Contract",
  "type": "object",
  "required": ["schema", "scene_id", "units", "parameters", "components", "relations", "edit_operations"],
  "properties": {
    "schema": {"type": "string", "const": "finescene.scene.v1"},
    "scene_id": {"type": "string", "minLength": 1},
    "brief": {"type": "string"},
    "units": {"type": "string", "const": "m"},
    "coordinate_frame": {"type": "object"},
    "parameters": {"type": "object", "additionalProperties": {"type": "number"}},
    "zones": {"type": "array", "items": {"type": "string"}},
    "furniture_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "kind", "zone", "placement", "parameters"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["bookshelf", "desk", "chair"]},
          "zone": {"type": "string"},
          "placement": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "parameters": {"type": "object", "additionalProperties": {"type": "number"}}
        },
        "additionalProperties": false
      }
    },
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "component_contract.schema.json"}},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to"],
        "properties": {
          "type": {"type": "string", "enum": ["parent", "attachment", "contact", "clearance", "depends_on", "supported_by", "inside", "facing", "adjacent_to"]},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "anchor_from": {"type": ["string", "null"]},
          "anchor_to": {"type": ["string", "null"]},
          "axis": {"type": ["string", "null"]},
          "value": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "edit_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "op", "parameter", "delta"],
        "properties": {
          "id": {"type": "string"},
          "op": {"type": "string", "enum": ["add", "set"]},
          "parameter": {"type": "string"},
          "delta": {"type": "number"},
          "expected_affected": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "planning_backend": {"type": "string"},
    "planning_assumptions": {"type": "array", "items": {"type": "string"}},
    "builder_parameter_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
