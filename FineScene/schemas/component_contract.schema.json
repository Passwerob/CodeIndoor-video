{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finescene.local/schema/component_contract.schema.json",
  "title": "FineScene Component Contract",
  "type": "object",
  "required": [
    "id",
    "kind",
    "parent",
    "bounds",
    "anchors",
    "editable",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "structure",
        "detail",
        "book",
        "prop",
        "generated",
        "retrieved",
        "shelf",
        "bookend"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "bounds": {
      "type": "object",
      "required": [
        "size",
        "unit"
      ],
      "properties": {
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "unit": {
          "type": "string",
          "const": "m"
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "rotation_deg": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "adsl",
            "retrieved",
            "trellis",
            "manual"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "geometry_size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "shelf_local_offset": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "layout_lean_deg": {
      "type": "number"
    },
    "layout_variant": {
      "type": "string"
    },
    "palette_index": {
      "type": "integer",
      "minimum": 0
    },
    "wall_attachment": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
